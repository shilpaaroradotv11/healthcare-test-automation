<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Medicare Parallel Suite"
       parallel="classes"
       thread-count="3"
       verbose="1">

    <listeners>
        <listener class-name="com.healthcare.automation.utilities.ExtentTestListener"/>
    </listeners>

    <test name="Parallel UI and API Tests">
        <classes>
            <class name="com.healthcare.automation.tests.SignupTest"/>
            <class name="com.healthcare.automation.tests.LoginTest"/>
            <class name="com.healthcare.automation.api.ProductApiTest"/>
        </classes>
    </test>

</suite>
